# Public site origin, used for metadata. Never put a password in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty for a custom domain. GitHub project Pages: /your-repository-name
BASE_PATH=
# Optional Umami-compatible analytics. Both values are needed to enable it.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Auth variant: runtime credentials only. Provision with a separate admin login.
DATABASE_URL=postgresql://myapp_runtime:password@localhost:5432/myapp?sslmode=disable
DB_SCHEMA=myapp
AUTH_SECRET=
BASE_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.org
